{
 "name": "stress_voices",
 "title": "rapid pad bursts: 12 and 20 pads held, 36 taps over the playing pattern; the voice pool stays inside 12, `cpu` shows no underrun, the master never clips",
 "steps": [
  {"run": "_load_tv16"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"keys": ["+shift", "f2", "-shift", "f1"], "gap": 0.3},
  {"state": {"pads": "NOTES"}, "within": 2},
  {"run": "_play"},
  {"wait": 1.0},
  {"run": "_stop"},
  {"wait": 1.0},
  {"cmd": "cpu", "expect": "underrun 0\\b", "note": "baseline: no underrun since boot (the counters are since boot: reboot between unrelated sessions)"},
  {"say": "A: twelve pads held down at once (the pool has 12 voices)"},
  {"pad": 0, "gesture": "down"},
  {"pad": 1, "gesture": "down"},
  {"pad": 2, "gesture": "down"},
  {"pad": 3, "gesture": "down"},
  {"pad": 4, "gesture": "down"},
