  {"pad": 11, "gesture": "down"},
  {"voices": {"min_in_use": 6}, "soft": true, "note": "(soft: one-shot samples end by themselves, the held pads keep looped ones)"},
  {"cmd": "voices", "expect": "in use (?:\\d|1[0-2])/12\\s+peak (?:\\d|1[0-2])\\s", "note": "never more than the pool"},
  {"pad": 0, "gesture": "up"},
