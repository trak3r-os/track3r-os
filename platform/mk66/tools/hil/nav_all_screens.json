{
 "name": "nav_all_screens",
 "title": "every screen and page the buttons reach: state screen/page, a shot that is not blank, the key-cap row against the simulator where it has a snap (soft)",
 "steps": [
  {"run": "_load_tv16"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"say": "PATTERN"},
  {"state": {"screen": "PATTERN", "overlay": "NONE"}, "within": 3},
  {"shot": "pattern", "compare": {"sim_scenario": "sim/scenarios/screens.txt", "snap": "pattern_start", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true, "note": "(soft: the key-cap row against the simulator's golden; needs --sim or --golden-dir)"},
  {"keys": ["song"], "gap": 0.5},
  {"state": {"screen": "SONG"}, "within": 3},
  {"keys": ["song"], "gap": 0.4, "if_state": {"page": "1"}, "note": "(page 0 first: Song again cycles LIST / TIMELINE)"},
  {"state": {"screen": "SONG", "page": "0"}, "within": 2},
  {"shot": "song_order", "compare": {"sim_scenario": "sim/scenarios/screens.txt", "snap": "song_start", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["song"], "gap": 0.4},
  {"state": {"screen": "SONG", "page": "1"}, "within": 2, "note": "the Timeline page"},
  {"shot": "song_timeline", "compare": {"sim_scenario": "sim/scenarios/screens.txt", "snap": "song_page2", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["song"], "gap": 0.4},
  {"state": {"screen": "SONG", "page": "0"}, "within": 2},
  {"keys": ["params"], "gap": 0.5},
  {"state": {"screen": "INSTRUMENT"}, "within": 3},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"screen": "INSTRUMENT", "page": "0", "overlay": "NONE"}, "within": 2},
  {"shot": "params_voice", "compare": {"sim_scenario": "sim/scenarios/params.txt", "snap": "voice", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["f3"], "gap": 0.4},
  {"state": {"screen": "INSTRUMENT", "page": "1"}, "within": 2},
  {"shot": "params_filter", "compare": {"sim_scenario": "sim/scenarios/params.txt", "snap": "filter", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["f4"], "gap": 0.4},
  {"state": {"screen": "INSTRUMENT", "page": "2"}, "within": 2},
  {"shot": "params_env", "compare": {"sim_scenario": "sim/scenarios/params.txt", "snap": "env_cutoff", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["f5"], "gap": 0.4},
  {"state": {"screen": "INSTRUMENT", "page": "3"}, "within": 2},
  {"shot": "params_sends", "compare": {"sim_scenario": "sim/scenarios/params.txt", "snap": "sends", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["f1"], "gap": 0.5},
  {"state": {"screen": "INSTRUMENT", "overlay": "NONE"}, "within": 3, "note": "F1 is the SOURCE page (SAMPLE), not the engine picker since OS-INSTUI"},
  {"keys": ["+vol", "+fx"], "gap": 0.0, "note": "(the Learn chord, FX1 + FX2 within 40 ms: soft, the console round trip may be slower than the chord window)"},
  {"state": {"overlay": "LEARN"}, "within": 2, "soft": true},
  {"keys": ["-fx", "-vol"], "gap": 0.1},
  {"shot": "params_learn", "non_blank": true, "soft": true},
  {"keys": ["f8"], "gap": 0.4, "if_state": {"overlay": "LEARN"}},
  {"state": {"overlay": "NONE"}, "within": 3},
  {"say": "the engine picker: F4 on a free slot (instrument 17 of t-v16), then back to instrument 1"},
  {"keys": ["f6"], "gap": 0.08, "repeat": 70, "note": "(to instrument 1: F6 stops there, no wrap)"},
  {"keys": ["f7"], "gap": 0.1, "repeat": 16},
  {"state": {"instrument": "17"}, "within": 3},
  {"keys": ["f4"], "gap": 0.5},
  {"state": {"overlay": "MODULE_PICKER"}, "within": 3},
  {"shot": "params_engine_picker", "non_blank": true},
  {"keys": ["f8"], "gap": 0.4},
  {"state": {"overlay": "NONE"}, "within": 3},
  {"keys": ["f6"], "gap": 0.08, "repeat": 70},
  {"keys": ["sampleplay"], "gap": 0.5},
  {"state": {"screen": "WAVE"}, "within": 3},
  {"keys": ["sampleplay"], "gap": 0.4, "if_state": {"page": "1"}},
  {"state": {"screen": "WAVE", "page": "0"}, "within": 2},
  {"shot": "wave", "non_blank": true},
  {"keys": ["sampleplay"], "gap": 0.4},
  {"state": {"screen": "WAVE", "page": "1"}, "within": 2},
  {"shot": "chop", "non_blank": true},
  {"keys": ["sampleplay"], "gap": 0.4},
  {"state": {"screen": "WAVE", "page": "0"}, "within": 2},
  {"keys": ["sampleedit"], "gap": 0.5},
  {"state": {"screen": "SAMPLE_EDIT"}, "within": 3},
  {"shot": "sample_edit", "non_blank": true},
  {"keys": ["sampleload"], "gap": 0.5},
  {"state": {"screen": "SAMPLE_LOAD"}, "within": 3},
  {"wait": 1.5, "note": "(the listing is a scan of the card)"},
  {"shot": "sample_load", "non_blank": true},
  {"keys": ["samplerec"], "gap": 0.5},
  {"state": {"screen": "RECORD"}, "within": 3},
  {"keys": ["samplerec"], "gap": 0.4, "if_state": {"page": "1"}},
  {"keys": ["samplerec"], "gap": 0.4, "if_state": {"page": "2"}},
  {"state": {"screen": "RECORD", "page": "0"}, "within": 2},
  {"shot": "record_sources", "non_blank": true},
  {"keys": ["samplerec"], "gap": 0.4},
  {"state": {"screen": "RECORD", "page": "1"}, "within": 2},
  {"shot": "record_resample", "non_blank": true},
  {"keys": ["samplerec"], "gap": 0.4},
  {"state": {"screen": "RECORD", "page": "2"}, "within": 2},
  {"shot": "record_radio", "non_blank": true},
  {"keys": ["samplerec"], "gap": 0.4},
  {"state": {"screen": "RECORD", "page": "0"}, "within": 2},
  {"keys": ["master"], "gap": 0.5},
  {"state": {"screen": "MIXER"}, "within": 3},
  {"keys": ["f1"], "gap": 0.4},
  {"state": {"screen": "MIXER", "page": "0"}, "within": 2},
  {"shot": "mixer_mixer", "non_blank": true},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"screen": "MIXER", "page": "1"}, "within": 2},
  {"shot": "mixer_routing", "non_blank": true},
  {"keys": ["f3"], "gap": 0.4},
  {"state": {"screen": "MIXER", "page": "2"}, "within": 2},
  {"shot": "mixer_master_fx", "non_blank": true},
  {"keys": ["f4"], "gap": 0.4},
  {"state": {"screen": "MIXER", "page": "3"}, "within": 2},
  {"shot": "mixer_stems", "non_blank": true},
  {"keys": ["f1"], "gap": 0.4},
  {"state": {"screen": "MIXER", "page": "0"}, "within": 2},
  {"keys": ["performance"], "gap": 0.5},
  {"state": {"screen": "PERFORM"}, "within": 3},
  {"shot": "perform", "non_blank": true},
  {"keys": ["file"], "gap": 0.5},
  {"state": {"screen": "FILE"}, "within": 3},
  {"wait": 1.0},
  {"shot": "file", "non_blank": true},
  {"keys": ["config"], "gap": 0.5},
  {"state": {"screen": "CONFIG"}, "within": 3},
  {"keys": ["f1"], "gap": 0.4},
  {"state": {"screen": "CONFIG", "page": "0"}, "within": 2},
  {"shot": "config_midi", "non_blank": true},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"screen": "CONFIG", "page": "1"}, "within": 2},
  {"shot": "config_display", "non_blank": true},
  {"keys": ["f3"], "gap": 0.4},
  {"state": {"screen": "CONFIG", "page": "2"}, "within": 2},
  {"shot": "config_sd", "non_blank": true},
  {"keys": ["f4"], "gap": 0.4},
  {"state": {"screen": "CONFIG", "page": "3"}, "within": 2},
  {"shot": "config_info", "non_blank": true},
  {"keys": ["f1"], "gap": 0.4},
  {"state": {"screen": "CONFIG", "page": "0"}, "within": 2},
  {"keys": ["pattern"], "gap": 0.5},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"keys": ["+song", "+pattern", "-pattern", "-song"], "gap": 0.5, "note": "(Song + Pattern chord, either order: the grid opens and stays open after both are released)"},
  {"state": {"overlay": "NAVIGATOR"}, "within": 3},
  {"shot": "navigator", "non_blank": true},
  {"keys": ["f8"], "gap": 0.4},
  {"state": {"screen": "PATTERN", "overlay": "NONE"}, "within": 3, "note": "F8 = BACK: no view change"},
  {"keys": ["+song", "+pattern", "-pattern", "-song"], "gap": 0.5},
  {"state": {"overlay": "NAVIGATOR"}, "within": 3},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN", "overlay": "NONE"}, "within": 3, "note": "Pattern again closes it"},
  {"keys": ["+song", "+pattern", "-pattern", "-song"], "gap": 0.5},
  {"state": {"overlay": "NAVIGATOR"}, "within": 3},
  {"enc": 32, "gap": 0.4, "note": "(the encoder moves one cell a detent and clamps at the last cell, MODULES; Shift + F5 is unbound in the Navigator since OS-SHIFTROW)"},
  {"keys": ["f1"], "gap": 0.5, "note": "F1 = GO"},
  {"state": {"screen": "MODULES", "overlay": "NONE"}, "within": 3},
  {"shot": "modules", "non_blank": true},
  {"keys": ["pattern"], "gap": 0.5},
  {"state": {"screen": "PATTERN"}, "within": 3}
 ],
 "finally": [
  {"keys": ["-pattern", "-shift"], "gap": 0.2},
  {"keys": ["-vol", "-fx"], "gap": 0.1},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.5}
 ]
}
