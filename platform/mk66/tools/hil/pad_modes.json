{
 "name": "pad_modes",
 "title": "the pad modes NOTES PIANO TRACKS ISO PATS VU FADERS by Shift + F2..F7 (Shift + F1 is the octave: the pads stay as they are, QA-PAT-313) and the Shift hold: state pads, the LEDs differ per mode, VU lights while playing, a FADERS tap lowers the master and undo restores",
 "steps": [
  {"run": "_load_tv16"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"keys": ["+shift", "f2", "-shift", "f1"], "gap": 0.3},
  {"state": {"pads": "NOTES", "shift": "0"}, "within": 2},
  {"leds": {"online": true, "within": 3, "snap": "notes"}},
  {"keys": ["+shift", "f2", "-shift", "f2"], "gap": 0.3},
  {"state": {"pads": "PIANO"}, "within": 2},
  {"leds": {"differs_from": "notes", "within": 3, "snap": "piano"}},
  {"pad": 12, "gesture": "down", "note": "PIANO: a pad plays the instrument"},
  {"voices": {"min_in_use": 1}, "soft": true},
  {"pad": 12, "gesture": "up"},
  {"keys": ["+shift", "f2", "-shift", "f4"], "gap": 0.3},
  {"state": {"pads": "TRACKS"}, "within": 2},
  {"leds": {"differs_from": "piano", "within": 3, "snap": "tracks"}},
  {"keys": ["+shift", "f2", "-shift", "f3"], "gap": 0.3},
  {"state": {"pads": "ISO"}, "within": 2},
  {"leds": {"differs_from": "tracks", "within": 3, "snap": "iso"}},
  {"pad": 20, "gesture": "down", "note": "ISO: a pad plays"},
  {"voices": {"min_in_use": 1}, "soft": true},
  {"pad": 20, "gesture": "up"},
  {"keys": ["+shift", "f1", "-shift"], "gap": 0.3},
  {"state": {"pads": "ISO"}, "within": 2, "note": "QA-PAT-313 (OS-PADOCT): Shift + F1 is the octave, not a mode: the pads stay ISO (the STEP mode has no key, QA-PAT-250)"},
  {"keys": ["+shift", "f2", "-shift", "f5"], "gap": 0.3},
  {"state": {"pads": "PATS"}, "within": 2},
  {"leds": {"differs_from": "iso", "within": 3, "snap": "pats"}},
  {"pad": 2, "note": "PATS, stopped: a pad selects pattern n+1 for editing"},
  {"state": {"pattern": "3"}, "within": 2},
  {"pad": 0},
  {"state": {"pattern": "1"}, "within": 2},
  {"run": "_play"},
  {"wait": 2.0},
  {"keys": ["+shift", "f2", "-shift", "f6"], "gap": 0.3},
  {"state": {"pads": "VU"}, "within": 2},
  {"leds": {"min_lit": 1, "within": 4, "snap": "vu"}, "note": "VU lights while the pattern plays"},
  {"mix": {"channels": {"MST L": {"min_rms_db": -60}}, "within": 4, "snap": "base"}},
  {"keys": ["+shift", "f2", "-shift", "f6"], "gap": 0.3},
  {"state": {"pads": "FADERS"}, "within": 2},
  {"leds": {"differs_from": "vu", "within": 3}, "soft": true, "note": "(faders show the volumes, VU the meters: soft because both may coincide for an instant)"},
  {"pad": 36, "note": "FADERS: row 4 of track 1 sets its volume to 25 %"},
  {"pad": 37},
  {"pad": 38},
  {"pad": 39},
  {"pad": 40},
  {"pad": 41},
  {"pad": 42},
  {"pad": 43},
  {"pad": 44},
  {"pad": 45},
  {"pad": 46},
  {"pad": 47},
  {"mix": {"drop": {"channel": "MST L", "field": "hold", "from": "base", "min_db": 3}, "within": 8, "snap": "faded"}, "soft": true, "note": "(soft: needs every track above 25 % at load)"},
  {"keys": ["f8"], "gap": 0.25, "repeat": 12},
  {"mix": {"rise": {"channel": "MST L", "field": "hold", "from": "faded", "min_db": 3}, "within": 8}, "soft": true, "note": "the volumes are back (12 undo units)"},
  {"run": "_stop"},
  {"say": "a lone Shift hold is TRACKS on the pads for as long as it is held"},
  {"keys": ["+shift", "f2", "-shift", "f1"], "gap": 0.3},
  {"state": {"pads": "NOTES"}, "within": 2},
  {"leds": {"within": 3, "snap": "n1"}},
  {"keys": ["+shift"], "gap": 0.3},
  {"state": {"shift": "1", "pads": "NOTES"}, "within": 2, "note": "the fixed mode is still NOTES: TRACKS is momentary"},
  {"leds": {"differs_from": "n1", "within": 3, "snap": "momentary"}},
  {"keys": ["-shift"], "gap": 0.3},
  {"state": {"shift": "0"}, "within": 2},
  {"leds": {"differs_from": "momentary", "within": 3}, "note": "released: the pads are NOTES again"}
 ],
 "finally": [
  {"keys": ["-shift"], "gap": 0.2},
  {"pad": 12, "gesture": "up"},
  {"pad": 20, "gesture": "up"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"keys": ["f8"], "gap": 0.2, "repeat": 13},
  {"keys": ["+shift", "f6", "-shift"], "gap": 0.3},
  {"pad": 0},
  {"keys": ["+shift", "f2", "-shift", "f1"], "gap": 0.3},
  {"run": "_stop"}
 ]
}
