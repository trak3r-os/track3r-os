{
 "name": "mixer_sends",
 "title": "OS-SENDFX: instrument 1's DELAY / REVERB sends up put the note on SNDA / SNDB and leave a tail on the master after the note; the master returns at 0, or the sends at 0, take the tail away; all restored",
 "steps": [
  {"run": "_load_tv16"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f7"], "gap": 0.3, "if_state": {"overlay": "NAVIGATOR"}, "note": "(a leftover Navigator is closed: F7 is CLOSE, F8 would GO since OS-NAV2)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP)$"}, "note": "(a leftover overlay is put away: F8 is Back)"},
  {"keys": ["f7"], "gap": 0.3, "if_state": {"overlay": "TEXT_ENTRY"}, "note": "(the on-screen keyboard is cancelled with F7, never accepted)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"run": "_play"},
  {"wait": 1.0},
  {"run": "_stop"},
  {"wait": 1.0, "note": "(the outputs are open now: the first Play opens them)"},
  {"keys": ["params"], "gap": 0.5},
  {"keys": ["f6"], "gap": 0.15, "until": {"instrument": "1"}, "max": 50, "note": "F6 steps down to instrument 1 (dim there; Shift + pad plays, it does not select)"},
  {"state": {"screen": "INSTRUMENT", "instrument": "1"}, "within": 2},
  {"cmd": "inst 1", "expect": "inst 01: mode \\d+", "soft": true, "note": "(soft: instrument 1 is a sample; the whole scenario is only as good as that)"},
  {"keys": ["params"], "gap": 0.5},
  {"state": {"screen": "INSTRUMENT"}, "within": 3},
  {"keys": ["f5"], "gap": 0.4},
  {"state": {"page": "3"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"enc": 64},
  {"enc": 64},
  {"keys": ["down"], "gap": 0.3},
  {"enc": 64},
  {"enc": 64},
  {"shot": "sends_up", "non_blank": true, "soft": true},
  {"keys": ["pattern"], "gap": 0.4},
  {"pad": 12, "gesture": "down"},
  {"wait": 0.8},
  {"mix": {"channels": {"SNDA": {}, "SNDB": {}}, "within": 3}, "soft": true, "note": "the send buses carry the note once the sends are up (SNDA = delay, SNDB = reverb)"},
  {"pad": 12, "gesture": "up"},
  {"wait": 2.5},
  {"mix": {"channels": {"MST L": {}}, "snap": "tail_on"}, "note": "(the master 2.5 s after the note: the send effects' tails)"},
  {"say": "the master returns to 0: the tail goes"},
  {"keys": ["master"], "gap": 0.5},
  {"state": {"screen": "MIXER"}, "within": 3},
  {"keys": ["f1"], "gap": 0.4},
  {"state": {"page": "0"}, "within": 2},
  {"keys": ["up"], "gap": 0.2},
  {"keys": ["left"], "gap": 0.1, "repeat": 20},
  {"keys": ["right"], "gap": 0.12, "repeat": 13},
  {"enc": -64},
  {"enc": -64},
  {"keys": ["right"], "gap": 0.3},
  {"enc": -64},
  {"enc": -64},
  {"keys": ["pattern"], "gap": 0.4},
  {"pad": 12, "gesture": "down"},
  {"wait": 0.8},
  {"pad": 12, "gesture": "up"},
  {"wait": 2.5},
  {"mix": {"drop": {"channel": "MST L", "field": "hold", "from": "tail_on", "min_db": 6}, "snap": "tail_returns_off"}, "soft": true},
  {"say": "returns back to default, sends to 0: no tail either"},
  {"keys": ["master"], "gap": 0.5},
  {"state": {"screen": "MIXER"}, "within": 3},
  {"keys": ["f1"], "gap": 0.4},
  {"state": {"page": "0"}, "within": 2},
  {"keys": ["up"], "gap": 0.2},
  {"keys": ["left"], "gap": 0.1, "repeat": 20},
  {"keys": ["right"], "gap": 0.12, "repeat": 13},
  {"keys": ["delete"], "gap": 0.3},
  {"keys": ["right"], "gap": 0.3},
  {"keys": ["delete"], "gap": 0.3},
  {"keys": ["params"], "gap": 0.5},
  {"state": {"screen": "INSTRUMENT"}, "within": 3},
  {"keys": ["f5"], "gap": 0.4},
  {"state": {"page": "3"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"keys": ["delete"], "gap": 0.3},
  {"keys": ["down"], "gap": 0.3},
  {"keys": ["delete"], "gap": 0.3},
  {"keys": ["pattern"], "gap": 0.4},
  {"pad": 12, "gesture": "down"},
  {"wait": 0.8},
  {"pad": 12, "gesture": "up"},
  {"wait": 2.5},
  {"mix": {"drop": {"channel": "MST L", "field": "hold", "from": "tail_on", "min_db": 6}, "snap": "tail_sends_off"}, "soft": true},
  {"say": "sends up again: the tail is back (a rise from the silent run)"},
  {"keys": ["params"], "gap": 0.5},
  {"state": {"screen": "INSTRUMENT"}, "within": 3},
  {"keys": ["f5"], "gap": 0.4},
  {"state": {"page": "3"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"enc": 64},
  {"enc": 64},
  {"keys": ["down"], "gap": 0.3},
  {"enc": 64},
  {"enc": 64},
  {"keys": ["pattern"], "gap": 0.4},
  {"pad": 12, "gesture": "down"},
  {"wait": 0.8},
  {"pad": 12, "gesture": "up"},
  {"wait": 2.5},
  {"mix": {"rise": {"channel": "MST L", "field": "hold", "from": "tail_sends_off", "min_db": 6}, "snap": "tail_again"}, "soft": true},
  {"keys": ["params"], "gap": 0.5},
  {"state": {"screen": "INSTRUMENT"}, "within": 3},
  {"keys": ["f5"], "gap": 0.4},
  {"state": {"page": "3"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"keys": ["delete"], "gap": 0.3},
  {"keys": ["down"], "gap": 0.3},
  {"keys": ["delete"], "gap": 0.3}
 ],
 "finally": [
  {"pad": 12, "gesture": "up"},
  {"keys": ["f7"], "gap": 0.3, "if_state": {"overlay": "NAVIGATOR"}, "note": "(a leftover Navigator is closed: F7 is CLOSE, F8 would GO since OS-NAV2)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP)$"}, "note": "(a leftover overlay is put away: F8 is Back)"},
  {"keys": ["f7"], "gap": 0.3, "if_state": {"overlay": "TEXT_ENTRY"}, "note": "(the on-screen keyboard is cancelled with F7, never accepted)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"keys": ["f8"], "gap": 0.2, "repeat": 40},
  {"run": "_stop"}
 ]
}
