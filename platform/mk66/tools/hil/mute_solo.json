{
 "name": "mute_solo",
 "title": "TRACKS layer (Shift held): mute and unmute sounding tracks, solo isolates one: the track meters and the master follow; every change is undone at the end",
 "steps": [
  {"run": "_load_tv16"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"run": "_play_song"},
  {"wait": 3.0},
  {"mix": {"min_tracks": 4, "channels": {"MST L": {"min_rms_db": -90}}, "within": 6, "snap": "base"}, "note": "the pattern is sounding (tracks 1, 6, 7, 8 were saved muted)"},
  {"cmd": "mix", "expect": ["(?m)^\\s*T02\\s", "(?m)^\\s*T03\\s"], "within": 6, "poll": 0.5, "soft": true, "note": "(soft: T02 and T03 have notes in the loop of t-v16)"},
  {"say": "MUTE one track: TRACKS layer (Shift held), row 2 of the pads = mute, pad 12 + track"},
  {"keys": ["+shift"], "gap": 0.3},
  {"pad": 13, "note": "mute T02"},
  {"keys": ["-shift"], "gap": 0.3},
  {"cmd": "mix", "expect_not": "(?m)^\\s*T02\\s", "within": 8, "poll": 0.5, "soft": true, "note": "T02's meter is gone from the list once its 1 s peak hold is empty"},
  {"cmd": "mix", "expect": "(?m)^\\s*T03\\s", "soft": true, "note": "the others sound on"},
  {"say": "MUTE every sounding track: the master falls"},
  {"keys": ["+shift"], "gap": 0.3},
  {"pad": 12, "note": "mute the rest"},
  {"pad": 14},
  {"pad": 15},
  {"pad": 16},
  {"pad": 17},
  {"pad": 18},
  {"pad": 19},
  {"pad": 20},
  {"pad": 21},
  {"pad": 22},
  {"pad": 23},
  {"keys": ["-shift"], "gap": 0.3},
  {"mix": {"drop": {"channel": "MST L", "field": "hold", "from": "base", "min_db": 12}, "within": 8, "snap": "silent"}},
  {"cmd": "mix", "expect_not": "(?m)^\\s*T(0[1-9]|1[0-2])\\s", "within": 6, "poll": 0.5, "soft": true, "note": "no sounding track is metering"},
  {"say": "UNMUTE all: tap the same pads again"},
  {"keys": ["+shift"], "gap": 0.3},
  {"pad": 12, "note": "unmute"},
  {"pad": 13},
  {"pad": 14},
  {"pad": 15},
  {"pad": 16},
  {"pad": 17},
  {"pad": 18},
  {"pad": 19},
  {"pad": 20},
  {"pad": 21},
  {"pad": 22},
  {"pad": 23},
  {"keys": ["-shift"], "gap": 0.3},
  {"mix": {"rise": {"channel": "MST L", "field": "hold", "from": "silent", "min_db": 12}, "within": 8}, "note": "the master is back"},
  {"cmd": "mix", "expect": ["(?m)^\\s*T02\\s", "(?m)^\\s*T03\\s"], "within": 6, "poll": 0.5, "soft": true},
  {"say": "SOLO T02: row 4 of the pads (36 + track); only it sounds"},
  {"keys": ["+shift"], "gap": 0.3},
  {"pad": 37, "note": "solo T02"},
  {"keys": ["-shift"], "gap": 0.3},
  {"cmd": "mix", "expect_not": "(?m)^\\s*T(0[13-9]|1[0-2])\\s", "within": 8, "poll": 0.5, "soft": true, "note": "the other tracks are silent"},
  {"cmd": "mix", "expect": "(?m)^\\s*T02\\s", "soft": true, "note": "T02 still sounds"},
  {"mix": {"drop": {"channel": "MST L", "field": "hold", "from": "base", "min_db": 3}, "within": 4}, "soft": true, "note": "(soft: with one track the master is lower than with all)"},
  {"say": "UNSOLO: tap again"},
  {"keys": ["+shift"], "gap": 0.3},
  {"pad": 37, "note": "unsolo"},
  {"keys": ["-shift"], "gap": 0.3},
  {"cmd": "mix", "expect": ["(?m)^\\s*T03\\s", "(?m)^\\s*T04\\s"], "within": 8, "poll": 0.5, "soft": true, "note": "the other tracks come back"},
  {"run": "_stop"}
 ],
 "finally": [
  {"keys": ["-shift"], "gap": 0.2},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"keys": ["f8"], "gap": 0.2, "repeat": 14},
  {"run": "_stop"}
 ]
}
