{
 "name": "slices_pads",
 "title": "OS-SLICEFIX: for each of the 16 instruments of t-v16 select it, play three NOTES pads: voices rise, `inst` tells the beat slices, nothing steals, no underrun",
 "steps": [
  {"run": "_load_tv16"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f7"], "gap": 0.3, "if_state": {"overlay": "NAVIGATOR"}, "note": "(a leftover Navigator is closed: F7 is CLOSE, F8 would GO since OS-NAV2)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP)$"}, "note": "(a leftover overlay is put away: F8 is Back)"},
  {"keys": ["f7"], "gap": 0.3, "if_state": {"overlay": "TEXT_ENTRY"}, "note": "(the on-screen keyboard is cancelled with F7, never accepted)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"keys": ["+shift", "f2", "-shift"], "gap": 0.3},
  {"state": {"pads": "NOTES"}, "within": 2},
  {"run": "_play"},
  {"wait": 1.0},
  {"run": "_stop"},
  {"say": "every instrument 1..16 of t-v16: selected on PARAMS by F6 down to 1 then F7 up, three pads played on Pattern; `inst n` soft-reports which are beat slices"},
  {"keys": ["params"], "gap": 0.4},
  {"keys": ["f6"], "gap": 0.15, "until": {"instrument": "1"}, "max": 50, "note": "F6 steps down to instrument 1 (dim there; Shift + pad plays, it does not select)"},
  {"state": {"screen": "INSTRUMENT", "instrument": "1"}, "within": 2},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 2},
  {"cmd": "inst 1", "expect": "inst 01: mode \\d+", "soft": true, "note": "(soft: a sample instrument is bound)"},
  {"cmd": "inst 1", "expect": "beat slices \\d+ first-note 24", "soft": true, "note": "(soft by design: only the beat slice instruments match)"},
  {"pad": 0, "gesture": "down"},
  {"pad": 5, "gesture": "down"},
  {"pad": 11, "gesture": "down"},
  {"voices": {"min_in_use": 1}, "soft": true},
  {"mix": {"channels": {"MST L": {"min_rms_db": -70}}, "within": 3}, "soft": true},
  {"pad": 0, "gesture": "up"},
  {"pad": 5, "gesture": "up"},
  {"pad": 11, "gesture": "up"},
  {"wait": 0.6},
  {"keys": ["params"], "gap": 0.4},
  {"keys": ["f7"], "gap": 0.3, "note": "instrument 2 (F7 steps up from the previous one; Shift + pad plays, it does not select)"},
