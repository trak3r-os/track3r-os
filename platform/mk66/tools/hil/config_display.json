{
 "name": "config_display",
 "title": "Config DISPLAY page: THEME Amiga -> Black -> White -> Amiga (and Shift + Master): each theme's screen is not blank and its key-cap row matches the simulator's theme (soft); the theme is put back to Amiga",
 "needs": ["card"],
 "steps": [
  {"card": {}, "note": "a device setting is written to Settings/device.o3st on the card 1.5 s after the change"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"keys": ["config"], "gap": 0.5, "if_state": {"screen": "~^(?!CONFIG$)"}},
  {"state": {"screen": "CONFIG"}, "within": 3},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"page": "1"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"keys": ["down"], "gap": 0.2, "repeat": 4, "note": "row 5 of DISPLAY: THEME (after DISPLAY, PAD LIGHTS, NUMBERING, MIDDLE C)"},
  {"keys": ["delete"], "gap": 0.4, "note": "THEME back to its default, Amiga: the run starts from a known theme"},
  {"shot": "config_amiga", "non_blank": true},
  {"keys": ["pattern"], "gap": 0.5},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"shot": "pattern_amiga", "compare": {"sim_scenario": "sim/scenarios/themes.txt", "snap": "amiga", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true, "note": "(soft: the key-cap row against the simulator's Amiga theme)"},
  {"keys": ["config"], "gap": 0.5, "if_state": {"screen": "~^(?!CONFIG$)"}},
  {"state": {"screen": "CONFIG"}, "within": 3},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"page": "1"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"keys": ["down"], "gap": 0.2, "repeat": 4, "note": "row 5 of DISPLAY: THEME (after DISPLAY, PAD LIGHTS, NUMBERING, MIDDLE C)"},
  {"enc": 1, "note": "THEME: Black"},
  {"shot": "config_black", "non_blank": true},
  {"keys": ["pattern"], "gap": 0.5},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"shot": "pattern_black", "compare": {"sim_scenario": "sim/scenarios/themes.txt", "snap": "black_by_key", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true, "note": "(soft: the key-cap row now matches the simulator's BLACK theme, and the earlier Amiga shot did not)"},
  {"keys": ["config"], "gap": 0.5, "if_state": {"screen": "~^(?!CONFIG$)"}},
  {"state": {"screen": "CONFIG"}, "within": 3},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"page": "1"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"keys": ["down"], "gap": 0.2, "repeat": 4, "note": "row 5 of DISPLAY: THEME (after DISPLAY, PAD LIGHTS, NUMBERING, MIDDLE C)"},
  {"enc": 1, "note": "THEME: White"},
  {"keys": ["pattern"], "gap": 0.5},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"shot": "pattern_white", "compare": {"sim_scenario": "sim/scenarios/themes.txt", "snap": "white_by_key", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["config"], "gap": 0.5, "if_state": {"screen": "~^(?!CONFIG$)"}},
  {"state": {"screen": "CONFIG"}, "within": 3},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"page": "1"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"keys": ["down"], "gap": 0.2, "repeat": 4, "note": "row 5 of DISPLAY: THEME (after DISPLAY, PAD LIGHTS, NUMBERING, MIDDLE C)"},
  {"keys": ["delete"], "gap": 0.4, "note": "Amiga again"},
  {"keys": ["pattern"], "gap": 0.5},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"shot": "pattern_amiga_again", "compare": {"sim_scenario": "sim/scenarios/themes.txt", "snap": "amiga_again", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"say": "the Shift + Master shortcut cycles the same themes (global, from any screen)"},
  {"keys": ["+shift", "master", "-shift"], "gap": 0.5},
  {"shot": "pattern_by_key_black", "compare": {"sim_scenario": "sim/scenarios/themes.txt", "snap": "black_by_key", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true},
  {"keys": ["+shift", "master", "-shift"], "gap": 0.5},
  {"keys": ["+shift", "master", "-shift"], "gap": 0.5},
  {"shot": "pattern_by_key_amiga", "compare": {"sim_scenario": "sim/scenarios/themes.txt", "snap": "amiga_again", "regions": ["0,458,800,22"], "tol": 24, "aa": 1, "max_bad": 0.005}, "non_blank": true, "soft": true}
 ],
 "finally": [
  {"keys": ["-shift"], "gap": 0.2},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["config"], "gap": 0.5, "if_state": {"screen": "~^(?!CONFIG$)"}},
  {"state": {"screen": "CONFIG"}, "within": 3},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"page": "1"}, "within": 2},
  {"keys": ["up"], "gap": 0.12, "repeat": 6},
  {"keys": ["down"], "gap": 0.2, "repeat": 4, "note": "row 5 of DISPLAY: THEME (after DISPLAY, PAD LIGHTS, NUMBERING, MIDDLE C)"},
  {"keys": ["delete"], "gap": 0.4},
  {"keys": ["pattern"], "gap": 0.5}
 ]
}
