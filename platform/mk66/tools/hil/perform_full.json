{
 "name": "perform_full",
 "title": "Perform: scene store and recall, RESET, LATCH, HALF / DOUBLE time (tempo in `state` while the key is held), NEXT PAT; the project tempo is set to 120 BPM on Song first and undone at the end",
 "steps": [
  {"run": "_load_tv16"},
  {"keys": ["-shift"], "gap": 0.2, "note": "(Shift released, in case a former run left it down)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3},
  {"run": "_stop"},
  {"cmd": "cpu reset", "note": "(the cpu counters are since boot or since this reset: a scenario that checks underruns / over-budget starts from zero)"},
  {"keys": ["song"], "gap": 0.5},
  {"state": {"screen": "SONG"}, "within": 3},
  {"keys": ["f7"], "gap": 0.4, "note": "F7 TEMPO: the encoder is on the tempo field now (and the press is a tap-tempo tap)"},
  {"enc": -64},
  {"enc": -64},
  {"enc": -64},
  {"enc": -64, "note": "40 BPM, the floor"},
  {"enc": 64},
  {"enc": 16, "note": "+80 detents of 1 BPM: 120.00 BPM"},
  {"keys": ["performance"], "gap": 0.5},
  {"state": {"screen": "PERFORM"}, "within": 3},
  {"shot": "perform_start", "non_blank": true},
  {"say": "NEXT PAT while stopped says so"},
  {"keys": ["f7"], "gap": 0.4},
  {"state": {"msg": "~^NOT_PLAYING$"}, "within": 2},
  {"say": "SCENES: a scene key tapped on an empty scene says so; held 1 s it stores"},
  {"keys": ["f8"], "gap": 0.4, "note": "RESET: every FX off"},
  {"leds": {"within": 3, "snap": "clean"}},
  {"keys": ["f2"], "gap": 0.4},
  {"state": {"msg": "~^SCENE_IS_EMPTY"}, "within": 2, "soft": true, "note": "(soft: scenes are runtime state; a load empties them)"},
  {"pad": 12, "note": "slot 1, row 1: the FX of the slot on at its first value"},
  {"leds": {"differs_from": "clean", "within": 3, "snap": "fx_on"}, "soft": true, "note": "(soft: whether a tap latches depends on the latch rule of the bank)"},
  {"keys": ["f1:1300"], "gap": 0.2, "note": "F1 held 1.3 s stores scene 1"},
  {"state": {"msg": "~^SCENE_1_STORED$"}, "within": 3},
  {"keys": ["f8"], "gap": 0.4},
  {"leds": {"differs_from": "fx_on", "within": 3, "snap": "reset"}, "soft": true},
  {"keys": ["f1"], "gap": 0.4, "note": "F1 tapped recalls scene 1"},
  {"state": {}, "ne": {"msg": "~^SCENE_IS_EMPTY"}, "within": 2},
  {"leds": {"differs_from": "reset", "within": 3}, "soft": true, "note": "the slot's FX is back"},
  {"keys": ["f8"], "gap": 0.4},
  {"say": "LATCH (F6) toggles; twice is the state it was"},
  {"keys": ["f6"], "gap": 0.4},
  {"shot": "perform_latch", "non_blank": true, "soft": true},
  {"keys": ["f6"], "gap": 0.4},
  {"say": "HALF (F4) and DOUBLE (F5) are rates while held: the tempo of `state` follows"},
  {"run": "_play"},
  {"wait": 1.0},
  {"state": {"tempo": "12000"}, "within": 4, "soft": true, "note": "120 BPM (soft: a Tempo FX in the pattern would move it)"},
  {"keys": ["+f4"], "gap": 0.2},
  {"state": {"tempo": "6000"}, "within": 4, "soft": true, "note": "half time while F4 is down"},
  {"state": {}, "ne": {"tempo": "12000"}, "within": 1, "soft": true},
  {"keys": ["-f4"], "gap": 0.2},
  {"state": {"tempo": "12000"}, "within": 4, "soft": true, "note": "released: the song's tempo"},
  {"keys": ["+f5"], "gap": 0.2},
  {"state": {"tempo": "24000"}, "within": 4, "soft": true, "note": "double time while F5 is down"},
  {"keys": ["-f5"], "gap": 0.2},
  {"state": {"tempo": "12000"}, "within": 4, "soft": true},
  {"keys": ["+f4", "+f5"], "gap": 0.2},
  {"state": {"tempo": "12000"}, "within": 4, "soft": true, "note": "both: the song's own rate"},
  {"keys": ["-f5", "-f4"], "gap": 0.2},
  {"say": "NEXT PAT (F7) while playing queues the next pattern of the song; again cancels"},
  {"keys": ["f7"], "gap": 0.4},
  {"state": {"msg": "~^(NEXT_PATTERN_QUEUED|PATTERN_IS_NOT_IN_THE_SONG|SONG_IS_EMPTY)$"}, "within": 2},
  {"keys": ["f7"], "gap": 0.4},
  {"state": {"msg": "~^(NEXT_PATTERN_CANCELLED|PATTERN_IS_NOT_IN_THE_SONG|SONG_IS_EMPTY)$"}, "within": 2, "soft": true},
  {"mix": {"channels": {"MST L": {"min_rms_db": -70, "max_clip": 0}}, "within": 4}, "note": "the audio is intact through all of it"},
  {"run": "_stop"},
  {"cmd": "cpu", "expect": "underrun 0\\b"},
  {"keys": ["pattern"], "gap": 0.4},
  {"state": {"screen": "PATTERN"}, "within": 3}
 ],
 "finally": [
  {"keys": ["-f4", "-f5"], "gap": 0.1},
  {"pad": 12, "gesture": "up"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"overlay": "~^(LEARN|PATTERN_CHOOSER|LENGTH_CHOOSER|JUMP_CHOOSER|MODULE_PICKER|STEP_POPUP|NAVIGATOR|TEXT_ENTRY)$"}, "note": "(a leftover overlay is put away: F8 is BACK on the Navigator, the keyboard (cancel, never accept: F1 accepts) and the choosers, OS-UXF-KEYS item 5)"},
  {"keys": ["f8"], "gap": 0.3, "if_state": {"screen": "PERFORM"}},
  {"keys": ["song"], "gap": 0.4},
  {"keys": ["f8"], "gap": 0.2, "repeat": 10},
  {"keys": ["pattern"], "gap": 0.4},
  {"run": "_stop"}
 ]
}
